module

public import Stafford38.Paper.Section6

@[expose] public section

/-!
# Theorem 1.1 and Corollary 6.3

`theorem_1_1` has exactly the type of the Mathlib-only challenge statement
`Stafford38Challenge.UniversalStatement`, and `theorem_1_1_fixedSource` that
of `Stafford38FixedSourceChallenge.UniversalFixedSourceStatement` (the
"moreover" clause with `F = Φ_g^{-1}(x₁)^{deg_B d}`).  Both are proved along
Sections 3–6 of the paper (`Section6.theorem_1_1_paper`).
-/

namespace Stafford38.Paper

universe u v

/-- **Theorem 1.1.** For every field `k` of characteristic zero, every `n ≥ 0`
and every nonzero `d ∈ A_n(k)` there is `F ∈ A_n(k)` with
`A_n(k) = dA_n(k) + FdA_n(k)`, i.e. `1 = dR + FdS` for some `R, S`. -/
theorem theorem_1_1 : Stafford38Challenge.UniversalStatement.{u} :=
  Section6.theorem_1_1_paper

/-- **Theorem 1.1, moreover.** If `n ≥ 1`, one may choose `F = ℓ^{deg_B d}`
for a linear symplectic coordinate `ℓ = Φ_g^{-1}(x₁)`. -/
theorem theorem_1_1_fixedSource :
    Stafford38FixedSourceChallenge.UniversalFixedSourceStatement.{u} :=
  Section6.theorem_1_1_fixedSource_paper

end Stafford38.Paper

namespace Stafford38.Paper.Section6

universe u v

/-- **[Sta78, Thm. 3.7]** (right-module version), as cited in the proof of
Corollary 6.3: every finitely generated torsion right `A_n(k)`-module `T` is
generated by two elements, and is stably two-generated (for `l ≥ 2` and
generators `a_1, …, a_{l+1}` there are `f_i` with `a_i + a_{l+1}f_i`,
`i ≤ l`, generating `T`).  Proved here from Theorem 1.1, which does not use
Corollary 6.3: `two_generators_of_identity` and
`stably_generated_of_identity`. -/
theorem stafford_1978_theorem_3_7 (k : Type u) [Field k] [CharZero k] (n : ℕ)
    (T : Type v) [AddCommGroup T] [Module (Stafford38Challenge.WeylAlg k n)ᵐᵒᵖ T]
    [Module.Finite (Stafford38Challenge.WeylAlg k n)ᵐᵒᵖ T]
    (hT : Section2.IsTorsion (Stafford38Challenge.WeylAlg k n) T) :
    (∃ t₁ t₂ : T, Submodule.span (Stafford38Challenge.WeylAlg k n)ᵐᵒᵖ ({t₁, t₂} : Set T) = ⊤) ∧
      IsStablyGenerated (Stafford38Challenge.WeylAlg k n) T 2 :=
  ⟨two_generators_of_identity (weyl_rightOreCondition (k := k) n)
      (fun d hd => Stafford38.Paper.theorem_1_1 k n d hd) hT,
    fun l hl => stably_generated_of_identity (weyl_rightOreCondition (k := k) n)
      (fun d hd => Stafford38.Paper.theorem_1_1 k n d hd) hT l (by omega)⟩

end Stafford38.Paper.Section6

namespace Stafford38.Paper

universe u v

/-- **Corollary 6.3** (Stafford 1978). Every finitely generated torsion right
`A_n(k)`-module is cyclic.  Proved as printed by `Section6.corollary_6_3_of`
from the cited [Sta78, Thm. 3.7] (`Section6.stafford_1978_theorem_3_7`),
Theorem 1.1 and the right Ore condition (`Section6.weyl_rightOreCondition`). -/
theorem corollary_6_3 (k : Type u) [Field k] [CharZero k] (n : ℕ)
    (T : Type v) [AddCommGroup T] [Module (Stafford38Challenge.WeylAlg k n)ᵐᵒᵖ T]
    [Module.Finite (Stafford38Challenge.WeylAlg k n)ᵐᵒᵖ T]
    (hT : Section2.IsTorsion (Stafford38Challenge.WeylAlg k n) T) :
    Section2.IsCyclic (Stafford38Challenge.WeylAlg k n) T :=
  (Section6.corollary_6_3_of (Section6.weyl_rightOreCondition (k := k) n)
    (fun d hd => theorem_1_1 k n d hd) hT
    (Section6.stafford_1978_theorem_3_7 k n T hT)).1

/-- **Corollary 6.3, stable cyclicity** (closing paragraph of the printed
proof, tex 1619).  Every finitely generated torsion right `A_n(k)`-module is
stably cyclic: for `l = 1` take `f₁ = -F`, for `l ≥ 2` use the stable
two-generation of the cited [Sta78, Thm. 3.7]
(`Section6.corollary_6_3_of`, second component). -/
theorem corollary_6_3_stablyCyclic (k : Type u) [Field k] [CharZero k] (n : ℕ)
    (T : Type v) [AddCommGroup T] [Module (Stafford38Challenge.WeylAlg k n)ᵐᵒᵖ T]
    [Module.Finite (Stafford38Challenge.WeylAlg k n)ᵐᵒᵖ T]
    (hT : Section2.IsTorsion (Stafford38Challenge.WeylAlg k n) T) :
    Section6.IsStablyGenerated (Stafford38Challenge.WeylAlg k n) T 1 :=
  (Section6.corollary_6_3_of (Section6.weyl_rightOreCondition (k := k) n)
    (fun d hd => theorem_1_1 k n d hd) hT
    (Section6.stafford_1978_theorem_3_7 k n T hT)).2

#print axioms theorem_1_1
#print axioms theorem_1_1_fixedSource
#print axioms corollary_6_3
#print axioms corollary_6_3_stablyCyclic
