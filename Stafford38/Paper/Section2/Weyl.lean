module

public import Stafford38.Weyl.PaperRightMonic
public import Stafford38.ChallengeDefinitions

@[expose] public section

/-!
# Section 2 of the paper: Definition 2.1 and Convention 2.2

Definition 2.1 (torsion and cyclic right modules) and Convention 2.2 (the first
Weyl pair `(x₁, p = ∂₁)`, the transverse algebra and `C = A_{n-1}(k)[x₁]`, and
the normal form `A_n(k) = ⊕_j p^j C`).

Indexing: the paper's `A_n(k)` with `n ≥ 1` is Lean's `PresentedWeyl k (n + 1)`;
the paper's transverse algebra `A_{n-1}(k) = k⟨x_i, ∂_i : i ≥ 2⟩` is the image
of `PresentedWeyl k n` under `previousWeylEmbedding`.
-/

namespace Stafford38.Paper.Section2

open AlgebraicAnalysis
open AlgebraicAnalysis.OreAssociativity
open AlgebraicAnalysis.OreRightPBW
open Stafford38.OreCoordinateStage
open Stafford38.OreIteratedPairStage
open Stafford38.OrePairStage
open Stafford38.WeylIteratedEquivalence
open Stafford38.WeylPaperRightMonic

noncomputable section

universe u v

section Modules

variable (A : Type u) (M : Type v) [Ring A] [AddCommGroup M] [Module Aᵐᵒᵖ M]

/-- **Definition 2.1 (torsion).** Every `m ∈ M` has `md = 0` for some
`0 ≠ d ∈ A`.  This is the repository's `TorsionCyclicity.IsRightTorsion`. -/
abbrev IsTorsion : Prop :=
  Stafford38.TorsionCyclicity.IsRightTorsion (A := A) (M := M)

/-- **Definition 2.1 (cyclic).** `M = mA` for some `m ∈ M`. -/
def IsCyclic : Prop :=
  ∃ m : M, ∀ x : M, ∃ a : A, x = MulOpposite.op a • m

/-- Cyclicity is the Mathlib form `span {m} = ⊤` used in the corollary. -/
theorem isCyclic_iff_span : IsCyclic A M ↔ ∃ m : M, Submodule.span Aᵐᵒᵖ {m} = ⊤ := by
  constructor
  · rintro ⟨m, hm⟩
    refine ⟨m, eq_top_iff.mpr fun x _ => ?_⟩
    obtain ⟨a, rfl⟩ := hm x
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self m)
  · rintro ⟨m, hm⟩
    refine ⟨m, fun x => ?_⟩
    have hx : x ∈ Submodule.span Aᵐᵒᵖ {m} := hm ▸ Submodule.mem_top
    obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hx
    exact ⟨a.unop, rfl⟩

end Modules

variable (k : Type u) [Field k]

local instance (n : ℕ) : Algebra k (IteratedPairStage k n) :=
  iteratedPairStageAlgebra k n

local instance (n : ℕ) :
    Algebra k (CoordinateStage (B := IteratedPairStage k n)) :=
  coordinateStageAlgebra

local instance (n : ℕ) :
    Algebra k (PairStage (B := IteratedPairStage k n)) :=
  pairStageAlgebra

local instance (n : ℕ) : Nontrivial (IteratedPairStage k n) := by
  induction n with
  | zero =>
      change Nontrivial k
      infer_instance
  | succ n ih =>
      have : Nontrivial (IteratedPairStage k n) := ih
      change Nontrivial (PairStage (B := IteratedPairStage k n))
      unfold PairStage CoordinateStage
      infer_instance

local instance (n : ℕ) : Nontrivial (CoordinateStage (B := IteratedPairStage k n)) := by
  unfold CoordinateStage
  infer_instance

/-- **Convention 2.2.** The coordinate `x₁` of the first Weyl pair. -/
abbrev x₁ (n : ℕ) : PresentedWeyl k (n + 1) := presentedCoordinate k n

/-- **Convention 2.2.** The momentum `p = ∂₁` of the first Weyl pair. -/
abbrev p (n : ℕ) : PresentedWeyl k (n + 1) := presentedMomentum k n

/-- **Convention 2.2.** The transverse algebra `A_{n-1}(k) = k⟨x_i, ∂_i : i ≥ 2⟩`. -/
abbrev transverse (n : ℕ) : Subalgebra k (PresentedWeyl k (n + 1)) :=
  (previousWeylEmbedding k n).range

/-- **Convention 2.2.** `C = A_{n-1}(k)[x₁]`, the subalgebra generated by the
transverse algebra and `x₁`. -/
def C (n : ℕ) : Subalgebra k (PresentedWeyl k (n + 1)) :=
  Algebra.adjoin k ((transverse k n : Set (PresentedWeyl k (n + 1))) ∪ {x₁ k n})

/-- `C` is the coefficient ring of the last Ore stage of the iterated Ore
presentation `A_n(k) = C[p; δ]`, embedded by `coordinateStageToPresented`. -/
theorem C_eq_range (n : ℕ) : C k n = (coordinateStageToPresented k n).range := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ (⟨w, rfl⟩ | hx)
    · refine ⟨normalCoefficient zeroDerivation (presentedToIterated k n w), ?_⟩
      change iteratedToPresented k (n + 1) (stageEmbedding k n (presentedToIterated k n w)) = _
      rw [iteratedToPresented_coefficient]
      exact congrArg (previousWeylEmbedding k n)
        (DFunLike.congr_fun (iteratedToPresented_comp_presentedToIterated k n) w)
    · rw [Set.mem_singleton_iff.mp hx]
      exact ⟨normalVariable zeroDerivation, iteratedToPresented_coordinate k n⟩
  · rintro _ ⟨z, rfl⟩
    obtain ⟨q, rfl⟩ := normalForm_surjective
      (zeroDerivation : OreDivisionDerivation (IteratedPairStage k n)) z
    induction q using Polynomial.induction_on' with
    | add q₁ q₂ h₁ h₂ =>
        rw [normalForm_add]
        change coordinateStageToPresented k n (normalForm _ q₁ + normalForm _ q₂) ∈ C k n
        rw [map_add]
        exact add_mem h₁ h₂
    | monomial i b =>
        rw [normalForm_monomial]
        change coordinateStageToPresented k n
          (normalCoefficient zeroDerivation b * normalVariable zeroDerivation ^ i) ∈ C k n
        rw [map_mul, map_pow]
        have hx : coordinateStageToPresented k n (normalVariable zeroDerivation) = x₁ k n :=
          iteratedToPresented_coordinate k n
        rw [hx]
        refine mul_mem (Algebra.subset_adjoin (Set.mem_union_left _ ?_))
          (pow_mem (Algebra.subset_adjoin (Set.mem_union_right _ (Set.mem_singleton _))) i)
        refine ⟨iteratedToPresented k n b, ?_⟩
        change _ = iteratedToPresented k (n + 1) (stageEmbedding k n b)
        rw [iteratedToPresented_coefficient]
        rfl

/-- The last Ore stage, mapped back to `A_{n+1}(k)`. -/
def stageToPresented (n : ℕ) :
    PairStage (B := IteratedPairStage k n) →ₐ[k] PresentedWeyl k (n + 1) :=
  iteratedToPresented k (n + 1)

theorem presentedToIterated_stageToPresented (n : ℕ)
    (x : PairStage (B := IteratedPairStage k n)) :
    presentedToIterated k (n + 1) (stageToPresented k n x) = x :=
  DFunLike.congr_fun (presentedToIterated_comp_iteratedToPresented k (n + 1)) x

theorem stageToPresented_rightPBWMonomial (n j : ℕ) :
    stageToPresented k n
        (rightPBWMonomial (coordinateDerivation :
          OreDivisionDerivation (CoordinateStage (B := IteratedPairStage k n))) j) =
      p k n ^ j := by
  have hmono : rightPBWMonomial (coordinateDerivation :
      OreDivisionDerivation (CoordinateStage (B := IteratedPairStage k n))) j =
      pairMomentum ^ j := by
    rw [rightPBWMonomial_apply, Polynomial.X_pow_eq_monomial, normalForm_monomial,
      map_one, one_mul]
    rfl
  rw [hmono, map_pow]
  exact congrArg (· ^ j) (iteratedToPresented_momentum k n)

theorem stageToPresented_rightTerm (n j : ℕ)
    (a : CoordinateStage (B := IteratedPairStage k n)) :
    stageToPresented k n
        (MulOpposite.op a • rightPBWMonomial (coordinateDerivation :
          OreDivisionDerivation (CoordinateStage (B := IteratedPairStage k n))) j) =
      p k n ^ j * coordinateStageToPresented k n a := by
  rw [rightPBWMonomial_op_smul, map_mul, ← rightPBWMonomial_apply,
    stageToPresented_rightPBWMonomial]
  rfl

/-- **Convention 2.2, relations.** `x₁` is central in `C`, `[p, x₁] = 1`, and
the transverse algebra commutes with `x₁` and `p`. -/
theorem convention_2_2_relations (n : ℕ) :
    p k n * x₁ k n = x₁ k n * p k n + 1 ∧
      (∀ c ∈ C k n, x₁ k n * c = c * x₁ k n) ∧
      ∀ t ∈ transverse k n, t * x₁ k n = x₁ k n * t ∧ t * p k n = p k n * t := by
  refine ⟨presentedMomentum_mul_coordinate k n, ?_, ?_⟩
  · intro c hc
    induction hc using Algebra.adjoin_induction with
    | mem x hx =>
        rcases hx with ⟨w, rfl⟩ | hx
        · exact presentedCoordinate_commutes_previous k n w
        · rw [Set.mem_singleton_iff.mp hx]
    | algebraMap r => exact (Algebra.commutes r _).symm
    | add x y _ _ hx hy => rw [mul_add, add_mul, hx, hy]
    | mul x y _ _ hx hy => rw [← mul_assoc, hx, mul_assoc, hy, mul_assoc]
  · rintro _ ⟨w, rfl⟩
    exact ⟨(presentedCoordinate_commutes_previous k n w).symm,
      (presentedMomentum_commutes_previous k n w).symm⟩

/-- **Convention 2.2, normal form (existence).** Every element of `A_n(k)` can
be written as `∑_j p^j c_j` with `c_j ∈ C`. -/
theorem convention_2_2_exists (n : ℕ) (d : PresentedWeyl k (n + 1)) :
    ∃ (L : ℕ) (a : ℕ → PresentedWeyl k (n + 1)), (∀ j, a j ∈ C k n) ∧
      d = ∑ j ∈ Finset.range L, p k n ^ j * a j := by
  let b := pairStage_rightOrePBWBasis (B := IteratedPairStage k n)
  let c := b.repr (presentedToIterated k (n + 1) d)
  let L := c.support.sup id + 1
  have hsub : c.support ⊆ Finset.range L := by
    intro j hj
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le (Finset.le_sup (f := id) hj))
  refine ⟨L, fun j => coordinateStageToPresented k n (c j).unop,
    fun j => (C_eq_range k n).symm ▸ ⟨_, rfl⟩, ?_⟩
  have hd : presentedToIterated k (n + 1) d =
      ∑ j ∈ Finset.range L, c j • rightPBWMonomial (coordinateDerivation :
        OreDivisionDerivation (CoordinateStage (B := IteratedPairStage k n))) j := by
    conv_lhs => rw [← b.linearCombination_repr (presentedToIterated k (n + 1) d)]
    rw [Finsupp.linearCombination_apply, Finsupp.sum_of_support_subset _ hsub _ (by simp)]
    apply Finset.sum_congr rfl
    intro j _
    simp [b, pairStage_rightOrePBWBasis]
    rfl
  have hback : d = stageToPresented k n (presentedToIterated k (n + 1) d) :=
    (DFunLike.congr_fun (iteratedToPresented_comp_presentedToIterated k (n + 1)) d).symm
  rw [hback, hd, map_sum]
  apply Finset.sum_congr rfl
  intro j _
  exact stageToPresented_rightTerm k n j (c j).unop

/-- **Convention 2.2, normal form (uniqueness).** If `∑_{j<L} p^j c_j = 0`
with `c_j ∈ C`, then every `c_j = 0`. -/
theorem convention_2_2_unique (n L : ℕ) (a : ℕ → PresentedWeyl k (n + 1))
    (ha : ∀ j, a j ∈ C k n) (h0 : ∑ j ∈ Finset.range L, p k n ^ j * a j = 0) :
    ∀ j < L, a j = 0 := by
  have hpre : ∀ j, ∃ z, coordinateStageToPresented k n z = a j := fun j => by
    have := ha j
    rw [C_eq_range] at this
    exact this
  choose b hb using hpre
  let D : OreDivisionDerivation (CoordinateStage (B := IteratedPairStage k n)) :=
    coordinateDerivation
  have hsum : rightPBWCombination D
      (∑ j ∈ Finset.range L, Finsupp.single j (MulOpposite.op (b j))) = 0 := by
    rw [map_sum]
    simp only [rightPBWCombination_single]
    have himg : stageToPresented k n
        (∑ j ∈ Finset.range L, MulOpposite.op (b j) • rightPBWMonomial D j) = 0 := by
      rw [map_sum, ← h0]
      apply Finset.sum_congr rfl
      intro j _
      rw [stageToPresented_rightTerm, hb]
    have := congrArg (presentedToIterated k (n + 1)) himg
    rwa [presentedToIterated_stageToPresented, map_zero] at this
  have hzero := (rightPBWCombination_injective D) (hsum.trans (map_zero _).symm)
  intro j hj
  have hj' := congrArg (fun f : ℕ →₀ (CoordinateStage (B := IteratedPairStage k n))ᵐᵒᵖ => f j)
    hzero
  simp only [Finsupp.coe_finsetSum, Finset.sum_apply, Finsupp.single_apply,
    Finset.sum_ite_eq', Finset.mem_range, ite_eq_left hj, Finsupp.coe_zero, Pi.zero_apply] at hj'
  rw [← hb, MulOpposite.op_injective (hj'.trans MulOpposite.op_zero.symm), map_zero]

end

end Stafford38.Paper.Section2
