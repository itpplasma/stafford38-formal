module

public import Stafford38.Paper.Support.DimensionTheory
public import Stafford38.Paper.Section5.GenericTangentRank
public import Stafford38.Geometry.SmoothAffineConormal
public import Stafford38.Geometry.ExactDivisorialVisibleFrameExistence
public import Mathlib.RingTheory.Smooth.Local
public import Mathlib.RingTheory.Etale.Kaehler

@[expose] public section

/-!
# The Jacobian criterion: Jacobian smooth points are Mathlib smooth points

Let `𝔭 ⊂ K[x] = K[x_1, …, x_n]` be prime, `y ∈ V(𝔭)`, and suppose that
`span {df_y : f ∈ 𝔭}` has dimension `c = n - trdeg_K Frac(K[x]/𝔭)`.  Choose
`f_1, …, f_c ∈ 𝔭` with independent differentials at `y` and let `P'` be the
localization of `K[x]` at `y`.

1. `B = P'/(f_1, …, f_c)` is a regular local ring: `dim B ≥ n - c` by Krull's height
   theorem (`le_height_ker_aeval`), and `𝔪_B` is generated by `n - c` linear forms
   (Taylor expansion and Nakayama).  Hence `B` is a domain.
2. The prime `𝔯 = ker(K[x] → B)` lies between `(f)` and `𝔭`.  At the generic point of
   `𝔯` the Jacobian of `f` still has rank `c` (a `c × c` minor is a unit at `y`), so
   `trdeg K[x]/𝔯 = dim Θ ≤ n - c = trdeg K[x]/𝔭` (Lemma 5.12(a)); a nonzero prime lowers
   the transcendence degree (`trdeg_quotient_lt`), so `𝔯 = 𝔭` and `𝔭 P' = (f) P'`.
3. Mathlib's local Jacobian criterion
   (`Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange`) for
   `P' → (K[x]/𝔭)_𝔪` then reduces smoothness to the independence of the `df_i(y)`.
-/

namespace Stafford38.Paper.Section5

open MvPolynomial IsLocalRing
open Stafford38.Paper.Support
open Stafford38.Geometry
open Stafford38.Geometry.AffineConormalSpan
open Stafford38.Geometry.CoisotropicTranslation

noncomputable section

universe u

section Taylor

variable {k : Type u} [Field k] {n : ℕ}

/-- The maximal ideal `𝔪_y = ker(eval_y)` of a point `y ∈ K^n`. -/
abbrev pointIdeal (y : Fin n → k) : Ideal (MvPolynomial (Fin n) k) :=
  RingHom.ker (MvPolynomial.aeval (R := k) y)

instance (y : Fin n → k) : (pointIdeal y).IsPrime := RingHom.ker_isPrime _

theorem mem_pointIdeal {y : Fin n → k} {g : MvPolynomial (Fin n) k} :
    g ∈ pointIdeal y ↔ MvPolynomial.eval y g = 0 := by
  rw [RingHom.mem_ker]
  rfl

/-- The linear form `Σ_j v_j (x_j - y_j)`. -/
def linearPart (y : Fin n → k) : (Fin n → k) →ₗ[k] MvPolynomial (Fin n) k where
  toFun v := ∑ j, C (v j) * (X j - C (y j))
  map_add' v w := by simp [add_mul, Finset.sum_add_distrib]
  map_smul' a v := by
    simp only [Pi.smul_apply, smul_eq_mul, map_mul, RingHom.id_apply]
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [MvPolynomial.smul_eq_C_mul]
    ring

theorem linearPart_mem (y v : Fin n → k) : linearPart y v ∈ pointIdeal y := by
  refine Ideal.sum_mem _ fun j _ ↦ Ideal.mul_mem_left (pointIdeal y) (C (v j)) ?_
  rw [mem_pointIdeal]
  simp

theorem linearPart_single (y : Fin n → k) (j : Fin n) :
    linearPart y (Pi.single j 1) = X j - C (y j) := by
  classical
  simp [linearPart, Pi.single_apply]

theorem differentialAt_add (y : Fin n → k) (p q : MvPolynomial (Fin n) k) :
    differentialAt y (p + q) = differentialAt y p + differentialAt y q := by
  funext i
  simp [differentialAt]

/-- **Taylor expansion to first order.** `g - g(y) - Σ_j ∂_j g(y) (x_j - y_j) ∈ 𝔪_y²`. -/
theorem taylor_mem_pointIdeal_sq (y : Fin n → k) (g : MvPolynomial (Fin n) k) :
    g - C (MvPolynomial.eval y g) - linearPart y (differentialAt y g) ∈ pointIdeal y ^ 2 := by
  classical
  induction g using MvPolynomial.induction_on with
  | C a =>
    have : differentialAt y (C a) = 0 := by funext i; simp [differentialAt]
    simp [this]
  | add p q hp hq =>
    rw [differentialAt_add, map_add]
    convert add_mem hp hq using 1
    simp only [map_add]
    ring
  | mul_X p j hp =>
    have hd : differentialAt y (p * X j) =
        y j • differentialAt y p + MvPolynomial.eval y p • Pi.single j 1 := by
      funext i
      simp only [differentialAt, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, map_add,
        map_mul, MvPolynomial.eval_X, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      by_cases h : i = j
      · subst h; simp; ring
      · simp [h, Ne.symm h]; ring
    have hid : p * X j - C (MvPolynomial.eval y (p * X j)) -
        linearPart y (differentialAt y (p * X j)) =
        linearPart y (differentialAt y p) * (X j - C (y j)) +
          (p - C (MvPolynomial.eval y p) - linearPart y (differentialAt y p)) * X j := by
      rw [hd, map_add, map_smul, map_smul, linearPart_single, MvPolynomial.eval_mul,
        MvPolynomial.eval_X, MvPolynomial.smul_eq_C_mul, MvPolynomial.smul_eq_C_mul, map_mul]
      ring
    rw [hid, pow_two]
    exact add_mem (Ideal.mul_mem_mul (linearPart_mem _ _) (by rw [mem_pointIdeal]; simp))
      (Ideal.mul_mem_right _ _ (pow_two (pointIdeal y) ▸ hp))

end Taylor

section RegularQuotient

variable {k : Type u} [Field k] {n : ℕ}

theorem withBot_natCast_le_of_add_le {a c : ℕ} {D : WithBot ℕ∞}
    (h : ((a + c : ℕ) : WithBot ℕ∞) ≤ D + c) : (a : WithBot ℕ∞) ≤ D := by
  induction D using WithBot.recBotCoe with
  | bot => simp at h
  | coe d =>
    induction d using ENat.recTopCoe with
    | top => exact_mod_cast le_top
    | coe d =>
      have : a + c ≤ d + c := by exact_mod_cast h
      exact_mod_cast (by omega : a ≤ d)

/-- Nakayama: if `𝔪 ⊆ N + 𝔪²` then `𝔪 ⊆ N`. -/
theorem maximalIdeal_le_of_le_sup_sq {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] {N : Ideal R} (h : maximalIdeal R ≤ N ⊔ maximalIdeal R * maximalIdeal R) :
    maximalIdeal R ≤ N := by
  apply Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
    (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge
  rw [smul_eq_mul]
  exact h

/-- **`P'/(f_1, …, f_c)` is a regular local ring, hence a domain**, when the `f_i` vanish
at `y` and have linearly independent differentials there. -/
theorem isDomain_localization_quotient {ι : Type*} [Fintype ι] (y : Fin n → k)
    (f : ι → MvPolynomial (Fin n) k) (hfy : ∀ i, MvPolynomial.eval y (f i) = 0)
    (hli : LinearIndependent k fun i ↦ differentialAt y (f i)) :
    IsDomain (Localization.AtPrime (pointIdeal y) ⧸
      (Ideal.span (Set.range f)).map
        (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)))) := by
  classical
  let 𝔮 : Ideal (MvPolynomial (Fin n) k) := Ideal.span (Set.range f)
  let 𝔮' : Ideal (Localization.AtPrime (pointIdeal y)) := 𝔮.map (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)))
  let c := Fintype.card ι
  have hcn : c ≤ n := by
    have := hli.fintype_card_le_finrank
    simpa using this
  have h𝔮M : 𝔮 ≤ pointIdeal y := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact mem_pointIdeal.2 (hfy i)
  have h𝔮'le : 𝔮' ≤ maximalIdeal (Localization.AtPrime (pointIdeal y)) := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.map_mono h𝔮M
  have hne : 𝔮' ≠ ⊤ := fun h ↦ (maximalIdeal.isMaximal (Localization.AtPrime (pointIdeal y))).ne_top (top_le_iff.1 (h ▸ h𝔮'le))
  have : Nontrivial ((Localization.AtPrime (pointIdeal y)) ⧸ 𝔮') := Ideal.Quotient.nontrivial_iff.2 hne
  have : IsLocalRing ((Localization.AtPrime (pointIdeal y)) ⧸ 𝔮') :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  -- `dim B ≥ n - c`
  have hdimP' : (n : WithBot ℕ∞) ≤ ringKrullDim (Localization.AtPrime (pointIdeal y)) := by
    rw [IsLocalization.AtPrime.ringKrullDim_eq_height (pointIdeal y) (Localization.AtPrime (pointIdeal y))]
    exact_mod_cast le_height_ker_aeval y
  have hsf : 𝔮'.spanFinrank ≤ c := by
    have h1 : 𝔮' = Ideal.span (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)) '' Set.range f) := Ideal.map_span _ _
    rw [h1]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite ((Set.finite_range f).image _)).trans ?_
    refine (Set.ncard_image_le (Set.finite_range f)).trans ?_
    rw [← Set.image_univ]
    refine (Set.ncard_image_le Set.finite_univ).trans ?_
    simp [c]
  have hdimB : ((n - c : ℕ) : WithBot ℕ∞) ≤ ringKrullDim ((Localization.AtPrime (pointIdeal y)) ⧸ 𝔮') := by
    have hht := height_le_ringKrullDim_quotient_add_spanFinrank (p := maximalIdeal (Localization.AtPrime (pointIdeal y))) h𝔮'le
    rw [IsLocalRing.maximalIdeal_height_eq_ringKrullDim] at hht
    apply withBot_natCast_le_of_add_le (c := c)
    calc (((n - c) + c : ℕ) : WithBot ℕ∞) = n := by rw [Nat.sub_add_cancel hcn]
      _ ≤ ringKrullDim (Localization.AtPrime (pointIdeal y)) := hdimP'
      _ ≤ ringKrullDim ((Localization.AtPrime (pointIdeal y)) ⧸ 𝔮') + 𝔮'.spanFinrank := hht
      _ ≤ ringKrullDim ((Localization.AtPrime (pointIdeal y)) ⧸ 𝔮') + c := by gcongr
  -- `𝔪_B` is generated by `n - c` elements
  let W : Submodule k (Fin n → k) := Submodule.span k (Set.range fun i ↦ differentialAt y (f i))
  obtain ⟨Wc, hWc⟩ := Submodule.exists_isCompl W
  have hWrank : Module.finrank k W = c := finrank_span_eq_card hli
  have hWcrank : Module.finrank k Wc = n - c := by
    have := Submodule.finrank_add_eq_of_isCompl hWc
    rw [Module.finrank_fin_fun, hWrank] at this
    omega
  let bc := Module.finBasis k Wc
  let ℓ : Fin (Module.finrank k Wc) → (MvPolynomial (Fin n) k) := fun t ↦ linearPart y (bc t)
  let J : Ideal (MvPolynomial (Fin n) k) := Ideal.span (Set.range ℓ)
  have hcover : pointIdeal y ≤ J ⊔ 𝔮 ⊔ pointIdeal y * pointIdeal y := by
    rw [← pow_two]
    intro a ha
    have ha0 : MvPolynomial.eval y a = 0 := mem_pointIdeal.1 ha
    have hT := taylor_mem_pointIdeal_sq y a
    rw [ha0, map_zero, sub_zero] at hT
    obtain ⟨w, hw, w', hw', hww⟩ := Submodule.mem_sup.1
      (hWc.sup_eq_top ▸ Submodule.mem_top : differentialAt y a ∈ W ⊔ Wc)
    have hW : W ≤ ((𝔮 ⊔ pointIdeal y ^ 2).restrictScalars k).comap (linearPart y) := by
      rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      have hTi := taylor_mem_pointIdeal_sq y (f i)
      rw [hfy i, map_zero, sub_zero] at hTi
      change linearPart y (differentialAt y (f i)) ∈ 𝔮 ⊔ pointIdeal y ^ 2
      have : linearPart y (differentialAt y (f i)) =
          f i - (f i - linearPart y (differentialAt y (f i))) := by ring
      rw [this]
      exact sub_mem (Ideal.mem_sup_left (Ideal.subset_span ⟨i, rfl⟩)) (Ideal.mem_sup_right hTi)
    have hWc' : linearPart y w' ∈ J := by
      have := bc.sum_repr ⟨w', hw'⟩
      have h2 : w' = ∑ t, bc.repr ⟨w', hw'⟩ t • (bc t : Fin n → k) := by
        have h := congrArg Subtype.val this
        rw [Submodule.coe_sum] at h
        simp_rw [Submodule.coe_smul] at h
        exact h.symm
      rw [h2, map_sum]
      exact Ideal.sum_mem _ fun t _ ↦ by
        rw [map_smul, MvPolynomial.smul_eq_C_mul]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨t, rfl⟩)
    have hsplit : a = (a - linearPart y (differentialAt y a)) + linearPart y w +
        linearPart y w' := by
      rw [add_assoc, ← map_add, hww]
      ring
    rw [hsplit]
    have hw2 : linearPart y w ∈ 𝔮 ⊔ pointIdeal y ^ 2 := hW hw
    refine add_mem (add_mem (Ideal.mem_sup_right hT) ?_) (Ideal.mem_sup_left
      (Ideal.mem_sup_left hWc'))
    obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.1 hw2
    rw [← huv]
    exact add_mem (Ideal.mem_sup_left (Ideal.mem_sup_right hu)) (Ideal.mem_sup_right hv)
  let φ : (MvPolynomial (Fin n) k) →+* (Localization.AtPrime (pointIdeal y)) ⧸ 𝔮' := (Ideal.Quotient.mk 𝔮').comp (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)))
  have h𝔪B : maximalIdeal ((Localization.AtPrime (pointIdeal y)) ⧸ 𝔮') = (pointIdeal y).map φ := by
    rw [← Ideal.map_map, Localization.AtPrime.map_eq_maximalIdeal,
      map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective]
  have h𝔮B : 𝔮.map φ = ⊥ := by
    rw [← Ideal.map_map]
    exact Ideal.map_quotient_self 𝔮'
  have hJle : J.map φ ≤ maximalIdeal ((Localization.AtPrime (pointIdeal y)) ⧸ 𝔮') := by
    rw [h𝔪B]
    apply Ideal.map_mono
    rw [Ideal.span_le]
    rintro _ ⟨t, rfl⟩
    exact linearPart_mem _ _
  have hNak : maximalIdeal ((Localization.AtPrime (pointIdeal y)) ⧸ 𝔮') ≤ J.map φ := by
    have h := Ideal.map_mono (f := φ) hcover
    have hsq : (pointIdeal y * pointIdeal y).map φ ≤
        (pointIdeal y).map φ * (pointIdeal y).map φ := by
      rw [Ideal.map_le_iff_le_comap]
      refine Ideal.mul_le.2 fun a ha b hb ↦ ?_
      rw [Ideal.mem_comap, map_mul]
      exact Ideal.mul_mem_mul (Ideal.mem_map_of_mem _ ha) (Ideal.mem_map_of_mem _ hb)
    rw [Ideal.map_sup, Ideal.map_sup, h𝔮B, sup_bot_eq] at h
    replace h := h.trans (sup_le_sup_left hsq _)
    rw [← h𝔪B] at h
    exact maximalIdeal_le_of_le_sup_sq (R := (Localization.AtPrime (pointIdeal y)) ⧸ 𝔮') h
  have heq : maximalIdeal ((Localization.AtPrime (pointIdeal y)) ⧸ 𝔮') = Ideal.span (φ '' Set.range ℓ) := by
    rw [le_antisymm hNak hJle, Ideal.map_span]
  have hμ : (maximalIdeal ((Localization.AtPrime (pointIdeal y)) ⧸ 𝔮')).spanFinrank ≤ n - c := by
    rw [heq]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite ((Set.finite_range ℓ).image _)).trans ?_
    refine (Set.ncard_image_le (Set.finite_range ℓ)).trans ?_
    rw [← Set.image_univ]
    refine (Set.ncard_image_le Set.finite_univ).trans ?_
    simp [hWcrank]
  exact isDomain_of_spanFinrank_maximalIdeal_le _ ((Localization.AtPrime (pointIdeal y)) ⧸ 𝔮') rfl
    ((by exact_mod_cast hμ : ((maximalIdeal ((Localization.AtPrime (pointIdeal y)) ⧸ 𝔮')).spanFinrank : WithBot ℕ∞) ≤
      ((n - c : ℕ) : WithBot ℕ∞)).trans hdimB)

end RegularQuotient

section GenericRank

variable {k : Type u} [Field k] {n : ℕ} {I : Ideal (MvPolynomial (Fin n) k)}
  {L : Type*} [Field L] [Algebra k L] [Algebra (MvPolynomial (Fin n) k ⧸ I) L]
  [IsScalarTower k (MvPolynomial (Fin n) k ⧸ I) L]

/-- The image of `p` in `L` is `p` evaluated at the point `(x̄_i)_i ∈ L^n`. -/
theorem algebraMap_quotient_mk_eq_eval₂ (p : MvPolynomial (Fin n) k) :
    algebraMap (MvPolynomial (Fin n) k ⧸ I) L (Ideal.Quotient.mk I p) =
      MvPolynomial.eval₂ (algebraMap k L) (GenericPointKaehlerConormal.genericPoint I L) p := by
  have hhom : MvPolynomial.aeval (GenericPointKaehlerConormal.genericPoint I L) =
      (IsScalarTower.toAlgHom k (MvPolynomial (Fin n) k ⧸ I) L).comp
        (Ideal.Quotient.mkₐ k I) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [GenericPointKaehlerConormal.genericPoint]
  have h := congrArg (fun φ ↦ φ p) hhom
  simpa [MvPolynomial.aeval_def] using h.symm

end GenericRank

section Generization

variable {k : Type u} [Field k] {n : ℕ}

/-- **The Jacobian rank does not drop at the generic point of a prime `𝔯 ⊆ 𝔪_y`.** If
`f_1, …, f_c ∈ 𝔯` have independent differentials at `y ∈ V(𝔯)`, the tangent space at the
generic point of `𝔯` has dimension at most `n - c`: a `c × c` minor of the Jacobian is `1`
at `y`, hence not in `𝔯`. -/
theorem finrank_genericTangent_le {ι : Type*} [Fintype ι] (𝔯 : Ideal (MvPolynomial (Fin n) k))
    [𝔯.IsPrime] (y : Fin n → k) (h𝔯 : 𝔯 ≤ pointIdeal y)
    (f : ι → MvPolynomial (Fin n) k) (hf : ∀ i, f i ∈ 𝔯)
    (hli : LinearIndependent k fun i ↦ differentialAt y (f i)) :
    Module.finrank (FractionRing (MvPolynomial (Fin n) k ⧸ 𝔯))
        (zariskiTangentSpace
          (GenericPointKaehlerConormal.genericPoint 𝔯 (FractionRing (MvPolynomial (Fin n) k ⧸ 𝔯)))
          (𝔯.map (MvPolynomial.map (algebraMap k (FractionRing (MvPolynomial (Fin n) k ⧸ 𝔯)))))) ≤
      n - Fintype.card ι := by
  classical
  let L := FractionRing (MvPolynomial (Fin n) k ⧸ 𝔯)
  let yb := GenericPointKaehlerConormal.genericPoint 𝔯 L
  let ψ : MvPolynomial (Fin n) k →+* L :=
    (algebraMap (MvPolynomial (Fin n) k ⧸ 𝔯) L).comp (Ideal.Quotient.mk 𝔯)
  have hψ : ∀ p, ψ p = MvPolynomial.eval₂ (algebraMap k L) yb p :=
    fun p ↦ algebraMap_quotient_mk_eq_eval₂ (I := 𝔯) (L := L) p
  have hψC : ∀ c : k, ψ (C c) = algebraMap k L c := by
    intro c; rw [hψ]; simp
  -- the Jacobian at `y` and at the generic point
  let A0 : Matrix ι (Fin n) k := Matrix.of fun i j ↦ differentialAt y (f i) j
  let AL : Matrix ι (Fin n) L := Matrix.of fun i j ↦ ψ (pderiv j (f i))
  have hA0surj : Function.Surjective A0.mulVecLin := by
    rw [← LinearMap.range_eq_top]
    apply Submodule.eq_top_of_finrank_eq
    have h1 : Module.finrank k (LinearMap.range A0.mulVecLin) = A0.rank := rfl
    rw [h1, Matrix.rank_eq_finrank_span_row]
    have hrows : Set.range A0.row = Set.range fun i ↦ differentialAt y (f i) := rfl
    rw [hrows, finrank_span_eq_card hli, Module.finrank_fintype_fun_eq_card]
  choose G hG using fun i' : ι ↦ hA0surj (Pi.single i' 1)
  let Mk : Matrix (Fin n) ι k := Matrix.of fun j i' ↦ G i' j
  have hA0Mk : A0 * Mk = 1 := by
    ext i i'
    have := congrFun (hG i') i
    simp only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct] at this
    simp only [Matrix.mul_apply, Mk, Matrix.of_apply, Matrix.one_apply]
    rw [this, Pi.single_apply]
  let N : Matrix ι ι (MvPolynomial (Fin n) k) :=
    Matrix.of fun i i' ↦ ∑ j, pderiv j (f i) * C (Mk j i')
  have hNy : (MvPolynomial.eval y).mapMatrix N = A0 * Mk := by
    ext i i'
    simp [N, A0, Matrix.mul_apply, differentialAt]
  have hdetN : N.det ∉ 𝔯 := by
    intro h
    have h1 := h𝔯 h
    rw [mem_pointIdeal, RingHom.map_det, hNy, hA0Mk, Matrix.det_one] at h1
    exact one_ne_zero h1
  have hNL : ψ.mapMatrix N = AL * Mk.map (algebraMap k L) := by
    ext i i'
    simp [N, AL, Matrix.mul_apply, hψC]
  have hdetL : IsUnit (AL * Mk.map (algebraMap k L)).det := by
    rw [← hNL, ← RingHom.map_det]
    refine isUnit_iff_ne_zero.2 fun h ↦ hdetN ?_
    have h' : algebraMap (MvPolynomial (Fin n) k ⧸ 𝔯) L (Ideal.Quotient.mk 𝔯 N.det) = 0 := h
    rw [(IsFractionRing.injective _ L).eq_iff' (map_zero _),
      Ideal.Quotient.eq_zero_iff_mem] at h'
    exact h'
  have hALsurj : Function.Surjective AL.mulVecLin := by
    intro v
    obtain ⟨u, hu⟩ := Matrix.mulVec_surjective_iff_isUnit.2
      ((Matrix.isUnit_iff_isUnit_det _).2 hdetL) v
    refine ⟨Matrix.mulVec (Mk.map (algebraMap k L)) u, ?_⟩
    rw [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hu]
  -- tangent vectors are killed by the Jacobian
  have hT : zariskiTangentSpace yb (𝔯.map (MvPolynomial.map (algebraMap k L))) ≤
      LinearMap.ker AL.mulVecLin := by
    intro w hw
    rw [zariskiTangentSpace, Submodule.mem_dualCoannihilator] at hw
    rw [LinearMap.mem_ker]
    funext i
    have hmem : MvPolynomial.map (algebraMap k L) (f i) ∈
        𝔯.map (MvPolynomial.map (algebraMap k L)) := Ideal.mem_map_of_mem _ (hf i)
    have h := hw (differentialCovector yb _) (Submodule.subset_span ⟨⟨_, hmem⟩, rfl⟩)
    simp only [differentialCovector_apply, differentialAt, pderiv_map, eval_map] at h
    simp only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, AL, Matrix.of_apply, hψ,
      Pi.zero_apply]
    exact h
  have hrn := LinearMap.finrank_range_add_finrank_ker AL.mulVecLin
  rw [LinearMap.range_eq_top.2 hALsurj, finrank_top, Module.finrank_fintype_fun_eq_card,
    Module.finrank_fin_fun] at hrn
  have hker : Module.finrank L (LinearMap.ker AL.mulVecLin) = n - Fintype.card ι := by
    omega
  exact (Submodule.finrank_mono hT).trans hker.le

end Generization

section LocalEquations

variable {k : Type u} [Field k] [CharZero k] {n : ℕ}

/-- **`𝔭 P' = (f_1, …, f_c) P'`.** Under the Jacobian hypothesis the equations `f_i`
generate `𝔭` near `y`: the kernel `𝔯` of `K[x] → P'/(f)` is a prime between `(f)` and `𝔭`
(`isDomain_localization_quotient`), of transcendence degree at most `n - c`
(`finrank_genericTangent_le`, Lemma 5.12(a)), hence equal to `𝔭` (`trdeg_quotient_toNat_lt`). -/
theorem map_le_map_span_of_jacobian (𝔓 : PrimeSpectrum (MvPolynomial (Fin n) k))
    {y : Fin n → k} (hy : y ∈ MvPolynomial.zeroLocus k 𝔓.asIdeal)
    {ι : Type*} [Fintype ι] (f : ι → MvPolynomial (Fin n) k) (hf : ∀ i, f i ∈ 𝔓.asIdeal)
    (hli : LinearIndependent k fun i ↦ differentialAt y (f i))
    (hc : Fintype.card ι +
      (Algebra.trdeg k (FractionRing (MvPolynomial (Fin n) k ⧸ 𝔓.asIdeal))).toNat = n) :
    𝔓.asIdeal.map (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y))) ≤
      (Ideal.span (Set.range f)).map
        (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y))) := by
  classical
  have h𝔓y : 𝔓.asIdeal ≤ pointIdeal y := fun g hg ↦ by
    rw [mem_pointIdeal]
    simpa using (MvPolynomial.mem_zeroLocus_iff.1 hy) g hg
  have hfy : ∀ i, MvPolynomial.eval y (f i) = 0 := fun i ↦ mem_pointIdeal.1 (h𝔓y (hf i))
  have hdom := isDomain_localization_quotient y f hfy hli
  let φ : MvPolynomial (Fin n) k →+* Localization.AtPrime (pointIdeal y) ⧸
      (Ideal.span (Set.range f)).map
        (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y))) :=
    (Ideal.Quotient.mk _).comp (algebraMap _ _)
  let 𝔯 := RingHom.ker φ
  have : 𝔯.IsPrime := RingHom.ker_isPrime φ
  have hf𝔯 : ∀ i, f i ∈ 𝔯 := fun i ↦ by
    rw [RingHom.mem_ker]
    exact (Ideal.Quotient.eq_zero_iff_mem).2
      (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩))
  have h𝔯𝔓 : 𝔯 ≤ 𝔓.asIdeal := by
    intro g hg
    rw [RingHom.mem_ker] at hg
    have hg' := (Ideal.Quotient.eq_zero_iff_mem).1 hg
    obtain ⟨⟨a, s⟩, hs⟩ := (IsLocalization.mem_map_algebraMap_iff (pointIdeal y).primeCompl
      (Localization.AtPrime (pointIdeal y))).1 hg'
    rw [← map_mul] at hs
    obtain ⟨t, ht⟩ := (IsLocalization.eq_iff_exists (pointIdeal y).primeCompl
      (Localization.AtPrime (pointIdeal y))).1 hs
    have hspan : Ideal.span (Set.range f) ≤ 𝔓.asIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact hf i
    have hmem : (t : MvPolynomial (Fin n) k) * (g * s) ∈ 𝔓.asIdeal := by
      rw [ht]
      exact Ideal.mul_mem_left _ _ (hspan a.2)
    have ht𝔓 : (t : MvPolynomial (Fin n) k) ∉ 𝔓.asIdeal := fun h ↦ t.2 (h𝔓y h)
    have hs𝔓 : (s : MvPolynomial (Fin n) k) ∉ 𝔓.asIdeal := fun h ↦ s.2 (h𝔓y h)
    rcases 𝔓.isPrime.mem_or_mem hmem with h | h
    · exact absurd h ht𝔓
    · rcases 𝔓.isPrime.mem_or_mem h with h | h
      · exact h
      · exact absurd h hs𝔓
  have h𝔓𝔯 : 𝔓.asIdeal ≤ 𝔯 := by
    by_contra hne
    have hlt : 𝔯 < 𝔓.asIdeal := lt_of_le_of_ne h𝔯𝔓 fun h ↦ hne h.ge
    have h1 := trdeg_quotient_toNat_lt (K := k) hlt
    have h2 := finrank_genericTangent_le 𝔯 y (h𝔯𝔓.trans h𝔓y) f hf𝔯 hli
    let R0 : PrimeSpectrum (MvPolynomial (Fin n) k) := ⟨𝔯, inferInstance⟩
    have hgen : IntermediateField.adjoin k (Set.range (GenericPointKaehlerConormal.genericPoint 𝔯
        (FractionRing (MvPolynomial (Fin n) k ⧸ 𝔯)))) = ⊤ := by
      have : GenericPointKaehlerConormal.genericPoint 𝔯
          (FractionRing (MvPolynomial (Fin n) k ⧸ 𝔯)) =
          AffineComponentCoordinateSplit.componentCoordinate R0 := funext fun _ ↦ rfl
      rw [this]
      exact ExactDivisorialVisibleFrameExistence.componentCoordinate_adjoin_eq_top R0
    have h512 := generic_tangent_finrank_eq_component_kaehler_finrank
      (E := FractionRing (MvPolynomial (Fin n) k ⧸ 𝔯)) (I := 𝔯) hgen
    simp only [Algebra.algebraMap_self, RingHom.id_apply] at h512
    have htr := (component_kaehler_finrank_eq_trdeg (k := k)
      (AffineComponentCoordinateSplit.componentCoordinate R0)
      (ExactDivisorialVisibleFrameExistence.componentCoordinate_adjoin_eq_top R0)).2
    have e1 := trdeg_fractionRing (K := k) (MvPolynomial (Fin n) k ⧸ 𝔯)
    have e2 := trdeg_fractionRing (K := k) (MvPolynomial (Fin n) k ⧸ 𝔓.asIdeal)
    change Module.finrank (FractionRing (MvPolynomial (Fin n) k ⧸ 𝔯))
      Ω[FractionRing (MvPolynomial (Fin n) k ⧸ 𝔯)⁄k] = _ at htr
    rw [e1] at htr
    rw [e2] at hc
    rw [h512, htr] at h2
    omega
  rw [Ideal.map_le_iff_le_comap]
  intro g hg
  have := h𝔓𝔯 hg
  rw [RingHom.mem_ker] at this
  rw [Ideal.mem_comap]
  exact (Ideal.Quotient.eq_zero_iff_mem (I := (Ideal.span (Set.range f)).map
    (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y))))).1 this

end LocalEquations

section Criterion

variable {k : Type u} [Field k] {n : ℕ}

set_option maxHeartbeats 2000000 in
open TensorProduct in
/-- The local Jacobian criterion for the presentation `P' → R_𝔪`, `R = K[x]/𝔭`, once
`𝔭 P' ⊆ (f_1, …, f_c) P'` with `f_i ∈ 𝔭` and independent `df_i(y)`.  The ring `R` is
abstracted as `A` with a surjection `π : K[x] → A` of kernel `𝔭`. -/
theorem formallySmooth_localization_of_jacobian
    {A : Type u} [CommRing A] [Algebra k A] (𝔭 : Ideal (MvPolynomial (Fin n) k)) [𝔭.IsPrime]
    (π : MvPolynomial (Fin n) k →ₐ[k] A) (hπ : Function.Surjective π)
    (hπker : ∀ p, π p = 0 ↔ p ∈ 𝔭) (y : Fin n → k) (e : A →ₐ[k] k)
    (heval : ∀ p, e (π p) = MvPolynomial.aeval y p)
    [(RingHom.ker e.toRingHom).IsPrime]
    {ι : Type*} [Fintype ι] (f : ι → MvPolynomial (Fin n) k) (hf : ∀ i, f i ∈ 𝔭)
    (hli : LinearIndependent k fun i ↦ differentialAt y (f i))
    (hloc : 𝔭.map (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y))) ≤
      (Ideal.span (Set.range f)).map
        (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)))) :
    Algebra.FormallySmooth k (Localization.AtPrime (RingHom.ker e.toRingHom)) := by
  classical
  have hMT : (pointIdeal y).primeCompl ≤ (RingHom.ker e.toRingHom).primeCompl.comap π.toRingHom := by
    intro s hs h
    apply hs
    have h' : e (π s) = 0 := h
    rw [heval] at h'
    exact h'
  let θ : (Localization.AtPrime (pointIdeal y)) →+* (Localization.AtPrime (RingHom.ker e.toRingHom)) := IsLocalization.map (Localization.AtPrime (RingHom.ker e.toRingHom)) π.toRingHom hMT
  let : Algebra (Localization.AtPrime (pointIdeal y)) (Localization.AtPrime (RingHom.ker e.toRingHom)) := θ.toAlgebra
  have hθ : ∀ p, θ (algebraMap _ (Localization.AtPrime (pointIdeal y)) p) = algebraMap A (Localization.AtPrime (RingHom.ker e.toRingHom)) (π p) := fun p ↦ IsLocalization.map_eq _ _
  have : IsScalarTower k (Localization.AtPrime (pointIdeal y)) (Localization.AtPrime (RingHom.ker e.toRingHom)) :=
    IsScalarTower.of_algebraMap_eq fun c ↦ by
      change _ = θ (algebraMap k (Localization.AtPrime (pointIdeal y)) c)
      rw [IsScalarTower.algebraMap_apply k (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)), hθ,
        IsScalarTower.algebraMap_apply k A (Localization.AtPrime (RingHom.ker e.toRingHom))]
      simp
  -- smoothness of `(Localization.AtPrime (pointIdeal y))` and its differentials
  have : Algebra.FormallyEtale (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)) :=
    .of_isLocalization (pointIdeal y).primeCompl
  have : Algebra.FormallySmooth k (Localization.AtPrime (pointIdeal y)) := .comp _ (MvPolynomial (Fin n) k) _
  have : Module.Free (Localization.AtPrime (pointIdeal y)) Ω[(Localization.AtPrime (pointIdeal y))⁄k] :=
    .of_equiv (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)))
  have : Module.Finite (Localization.AtPrime (pointIdeal y)) Ω[(Localization.AtPrime (pointIdeal y))⁄k] :=
    .of_surjective (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k
      (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y))).toLinearMap (LinearEquiv.surjective _)
  -- surjectivity and kernel
  have h₁ : Function.Surjective (algebraMap (Localization.AtPrime (pointIdeal y)) (Localization.AtPrime (RingHom.ker e.toRingHom))) := by
    intro z
    obtain ⟨⟨a, t⟩, rfl⟩ := IsLocalization.mk'_surjective (RingHom.ker e.toRingHom).primeCompl z
    obtain ⟨p, rfl⟩ := hπ a
    obtain ⟨q, hq⟩ := hπ (t : A)
    have hq' : q ∈ (pointIdeal y).primeCompl := by
      intro h
      apply t.2
      rw [← hq]
      change e (π q) = 0
      rw [heval]
      exact h
    refine ⟨IsLocalization.mk' (Localization.AtPrime (pointIdeal y)) p ⟨q, hq'⟩, ?_⟩
    change θ _ = _
    rw [IsLocalization.map_mk']
    congr 1
    exact Subtype.ext hq
  have h₂ : (RingHom.ker (algebraMap (Localization.AtPrime (pointIdeal y)) (Localization.AtPrime (RingHom.ker e.toRingHom)))).FG := IsNoetherian.noetherian _
  let 𝔮' : Ideal (Localization.AtPrime (pointIdeal y)) := (Ideal.span (Set.range f)).map (algebraMap (MvPolynomial (Fin n) k) _)
  have hker : RingHom.ker (algebraMap (Localization.AtPrime (pointIdeal y)) (Localization.AtPrime (RingHom.ker e.toRingHom))) ≤ 𝔮' := by
    intro z hz
    obtain ⟨⟨p, q⟩, rfl⟩ := IsLocalization.mk'_surjective (pointIdeal y).primeCompl z
    rw [RingHom.mem_ker] at hz
    change θ _ = 0 at hz
    rw [IsLocalization.map_mk', IsLocalization.mk'_eq_zero_iff] at hz
    obtain ⟨⟨m, hm⟩, hm0⟩ := hz
    obtain ⟨r, rfl⟩ := hπ m
    have hm0' : r * p ∈ 𝔭 := (hπker _).1 (by rw [map_mul]; exact hm0)
    have hr : r ∉ 𝔭 := fun h ↦ hm (by
      change (π r) ∈ (RingHom.ker e.toRingHom)
      rw [(hπker r).2 h]
      exact (RingHom.ker e.toRingHom).zero_mem)
    have hp : p ∈ 𝔭 := (Ideal.IsPrime.mem_or_mem inferInstance hm0').resolve_left hr
    have : algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)) p ∈ 𝔮' := hloc (Ideal.mem_map_of_mem _ hp)
    change IsLocalization.mk' _ p q ∈ 𝔮'
    rw [IsLocalization.mk'_eq_mul_mk'_one]
    exact Ideal.mul_mem_right _ _ this
  have hmemN : ∀ i, algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)) (f i) ∈
      RingHom.ker (algebraMap (Localization.AtPrime (pointIdeal y)) (Localization.AtPrime (RingHom.ker e.toRingHom))) := by
    intro i
    rw [RingHom.mem_ker]
    change θ _ = 0
    rw [hθ, (hπker _).2 (hf i), map_zero]
  have h𝔮N : 𝔮' ≤ RingHom.ker (algebraMap (Localization.AtPrime (pointIdeal y)) (Localization.AtPrime (RingHom.ker e.toRingHom))) := by
    rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact hmemN i
  rw [Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange_residueField (Localization.AtPrime (pointIdeal y)) h₁ h₂]
  -- the point `y` in the residue field
  let : Algebra (MvPolynomial (Fin n) k) (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) :=
    ((algebraMap (Localization.AtPrime (pointIdeal y)) (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom)))).comp (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)))).toAlgebra
  have : IsScalarTower (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)) (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have : IsScalarTower k (MvPolynomial (Fin n) k) (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) := IsScalarTower.of_algebraMap_eq fun c ↦ by
    change _ = algebraMap (Localization.AtPrime (pointIdeal y)) (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) (algebraMap _ (Localization.AtPrime (pointIdeal y)) (C c))
    rw [← MvPolynomial.algebraMap_eq,
      ← IsScalarTower.algebraMap_apply k (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)),
      ← IsScalarTower.algebraMap_apply k (Localization.AtPrime (pointIdeal y))]
  have hRFy : ∀ p : MvPolynomial (Fin n) k, algebraMap (MvPolynomial (Fin n) k) (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) p =
      MvPolynomial.aeval (algebraMap k (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) ∘ y) p := by
    intro p
    rw [MvPolynomial.aeval_algebraMap_apply]
    change IsLocalRing.residue (Localization.AtPrime (RingHom.ker e.toRingHom)) (θ (algebraMap _ (Localization.AtPrime (pointIdeal y)) p)) =
      IsLocalRing.residue (Localization.AtPrime (RingHom.ker e.toRingHom)) (algebraMap k (Localization.AtPrime (RingHom.ker e.toRingHom)) (aeval y p))
    rw [hθ, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff,
      IsScalarTower.algebraMap_apply k A (Localization.AtPrime (RingHom.ker e.toRingHom)), ← map_sub,
      ← Localization.AtPrime.map_eq_maximalIdeal]
    apply Ideal.mem_map_of_mem
    change e _ = 0
    rw [map_sub, heval, AlgHom.commutes]
    simp
  have hRFk : ∀ s : (pointIdeal y).primeCompl,
      algebraMap (MvPolynomial (Fin n) k) (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) s ≠ 0 := by
    intro s h
    rw [hRFy, MvPolynomial.aeval_algebraMap_apply] at h
    refine s.2 (mem_pointIdeal.2 ?_)
    rw [← MvPolynomial.coe_aeval_eq_eval]
    exact (FaithfulSMul.algebraMap_injective k (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom)))) (h.trans (map_zero _).symm)
  have hunitP : ∀ s : (pointIdeal y).primeCompl,
      IsUnit (algebraMap (MvPolynomial (Fin n) k) (Module.End (MvPolynomial (Fin n) k) (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom)))) s) := by
    intro s
    rw [Module.End.isUnit_iff]
    have hs := hRFk s
    have hfun : ⇑(algebraMap (MvPolynomial (Fin n) k) (Module.End (MvPolynomial (Fin n) k) (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom)))) s) =
        fun x ↦ algebraMap (MvPolynomial (Fin n) k) (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) s * x :=
      funext fun x ↦ Algebra.smul_def (s : MvPolynomial (Fin n) k) x
    rw [hfun]
    exact ⟨mul_right_injective₀ hs, fun x ↦ ⟨(algebraMap _ (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) (s : MvPolynomial (Fin n) k))⁻¹ * x,
      by simp only; rw [← mul_assoc, mul_inv_cancel₀ hs, one_mul]⟩⟩
  -- the differentials at `y` as functionals on `κ ⊗ Ω_{(Localization.AtPrime (pointIdeal y))}`
  let Θ : Fin n → ((IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) ⊗[(Localization.AtPrime (pointIdeal y))]
      Ω[(Localization.AtPrime (pointIdeal y))⁄k] →ₗ[(IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom)))] (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom)))) := fun j ↦
    LinearMap.liftBaseChange (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom)))
      (LinearMap.extendScalarsOfIsLocalization (pointIdeal y).primeCompl
        (Localization.AtPrime (pointIdeal y))
        (IsLocalizedModule.lift (pointIdeal y).primeCompl
          (KaehlerDifferential.map k k (MvPolynomial (Fin n) k)
            (Localization.AtPrime (pointIdeal y)))
          (mkDerivation k (Pi.single j (1 : (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))))) :
            Derivation k (MvPolynomial (Fin n) k) (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom)))).liftKaehlerDifferential hunitP))
  have hΘ : ∀ j p, Θ j ((1 : (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom)))) ⊗ₜ KaehlerDifferential.D k _
      (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (pointIdeal y)) p)) =
      algebraMap k (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) (differentialAt y p j) := by
    intro j p
    simp only [Θ, LinearMap.liftBaseChange_tmul, one_smul,
      LinearMap.extendScalarsOfIsLocalization_apply']
    rw [← KaehlerDifferential.map_D k k, IsLocalizedModule.lift_apply,
      Derivation.liftKaehlerDifferential_comp_D,
      GenericPointKaehlerConormal.mkDerivation_eq_sum_pderiv _ _ hRFy]
    rw [Finset.sum_eq_single j (fun i _ hij ↦ by rw [Pi.single_eq_of_ne hij, mul_zero])
      (by simp), Pi.single_eq_same, mul_one, MvPolynomial.aeval_algebraMap_apply]
    rfl
  -- the generators `1 ⊗ f_i` span `κ ⊗ ker`
  let N := RingHom.ker (algebraMap (Localization.AtPrime (pointIdeal y))
    (Localization.AtPrime (RingHom.ker e.toRingHom)))
  let u : ι → (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) ⊗[(Localization.AtPrime (pointIdeal y))] N :=
    fun i ↦ (1 : (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom)))) ⊗ₜ ⟨_, hmemN i⟩
  have key : ∀ x (hx : x ∈ 𝔮'), ∀ a : (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))),
      a ⊗ₜ (⟨x, h𝔮N hx⟩ : N) ∈ Submodule.span (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) (Set.range u) := by
    intro x hx
    have hx' : x ∈ Ideal.span (algebraMap (MvPolynomial (Fin n) k) _ '' Set.range f) := by
      have h' : x ∈ Ideal.map (algebraMap (MvPolynomial (Fin n) k)
          (Localization.AtPrime (pointIdeal y))) (Ideal.span (Set.range f)) := hx
      rwa [Ideal.map_span] at h'
    induction hx' using Submodule.span_induction with
    | mem x hxs =>
      obtain ⟨_, ⟨i, rfl⟩, rfl⟩ := hxs
      intro a
      have : a ⊗ₜ (⟨_, h𝔮N hx⟩ : N) = a • u i := by
        simp only [u, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [this]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    | zero =>
      intro a
      have : (⟨0, h𝔮N hx⟩ : N) = 0 := rfl
      rw [this, TensorProduct.tmul_zero]
      exact Submodule.zero_mem _
    | add x z hx₁ hz₁ ihx ihz =>
      intro a
      have hx2 : x ∈ 𝔮' := by
        change x ∈ Ideal.map _ (Ideal.span (Set.range f)); rw [Ideal.map_span]; exact hx₁
      have hz2 : z ∈ 𝔮' := by
        change z ∈ Ideal.map _ (Ideal.span (Set.range f)); rw [Ideal.map_span]; exact hz₁
      have : (⟨x + z, h𝔮N hx⟩ : N) = ⟨x, h𝔮N hx2⟩ + ⟨z, h𝔮N hz2⟩ := rfl
      rw [this, TensorProduct.tmul_add]
      exact Submodule.add_mem _ (ihx hx2 a) (ihz hz2 a)
    | smul c x hx₁ ihx =>
      intro a
      have hx2 : x ∈ 𝔮' := by
        change x ∈ Ideal.map _ (Ideal.span (Set.range f)); rw [Ideal.map_span]; exact hx₁
      have : (⟨c • x, h𝔮N hx⟩ : N) = c • ⟨x, h𝔮N hx2⟩ := rfl
      rw [this, ← TensorProduct.smul_tmul]
      exact ihx hx2 (c • a)
  have hspan : ∀ t : (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) ⊗[(Localization.AtPrime (pointIdeal y))] N,
      t ∈ Submodule.span (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) (Set.range u) := by
    intro t
    induction t using TensorProduct.inductionOn with
    | tmul a z => exact key z.1 (hker z.2) a
    | add t₁ t₂ h₁ h₂ => exact Submodule.add_mem _ h₁ h₂
  have hliRF : LinearIndependent (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) fun i j ↦ algebraMap k (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) (differentialAt y (f i) j) :=
    (linearIndependent_algebraMap_comp_iff (R := k) (S := (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom)))) (ι' := Fin n)).2 hli
  rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
  intro t ht
  obtain ⟨a, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom)))).1 (hspan t)
  rw [LinearMap.mem_ker, map_sum] at ht
  have hχ : ∀ i, KaehlerDifferential.cotangentComplexBaseChange k (Localization.AtPrime (RingHom.ker e.toRingHom))
      (Localization.AtPrime (pointIdeal y)) (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom)))
      (u i) = (1 : IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) ⊗ₜ
        KaehlerDifferential.D k _ (algebraMap (MvPolynomial (Fin n) k)
          (Localization.AtPrime (pointIdeal y)) (f i)) := by
    intro i
    rw [KaehlerDifferential.cotangentComplexBaseChange_tmul, one_smul]
    rfl
  have hcoef : ∑ i, a i • (fun j ↦ algebraMap k (IsLocalRing.ResidueField (Localization.AtPrime (RingHom.ker e.toRingHom))) (differentialAt y (f i) j)) = 0 := by
    funext j
    have := congrArg (Θ j) ht
    simp only [map_sum, map_smul, map_zero, hχ, hΘ] at this
    simp only [Finset.sum_apply, Pi.smul_apply, Pi.zero_apply]
    exact this
  have ha := (Fintype.linearIndependent_iff.1 hliRF) a hcoef
  simp only [ha, zero_smul, Finset.sum_const_zero]


open Stafford38.Geometry.SmoothAffineConormal in
/-- **Jacobian smooth points are Mathlib smooth points.** If `f_1, …, f_c ∈ 𝔭` have
independent differentials at `y ∈ V(𝔭)` and `c + trdeg_K Frac(K[x]/𝔭) = n`, then `y` is a
smooth point of `K[x]/𝔭`. -/
theorem smoothAffinePoint_of_jacobian [IsAlgClosed k] [CharZero k]
    (𝔓 : PrimeSpectrum (MvPolynomial (Fin n) k))
    {y : Fin n → k} (hy : y ∈ MvPolynomial.zeroLocus k 𝔓.asIdeal)
    {ι : Type*} [Fintype ι] (f : ι → MvPolynomial (Fin n) k) (hf : ∀ i, f i ∈ 𝔓.asIdeal)
    (hli : LinearIndependent k fun i ↦ differentialAt y (f i))
    (hc : Fintype.card ι +
      (Algebra.trdeg k (FractionRing (MvPolynomial (Fin n) k ⧸ 𝔓.asIdeal))).toNat = n) :
    SmoothAffinePoint 𝔓.asIdeal y := by
  have hloc := map_le_map_span_of_jacobian 𝔓 hy f hf hli hc
  have hyI : ∀ p ∈ 𝔓.asIdeal, MvPolynomial.aeval y p = 0 := fun p hp ↦
    (MvPolynomial.mem_zeroLocus_iff.1 hy) p hp
  let e : (MvPolynomial (Fin n) k ⧸ 𝔓.asIdeal) →ₐ[k] k := Ideal.Quotient.liftₐ _ (aeval y) hyI
  have heval : ∀ p, e (Ideal.Quotient.mk 𝔓.asIdeal p) = MvPolynomial.aeval y p := fun p ↦ by
    simp [e]
  refine ⟨e, heval, ?_⟩
  have : (RingHom.ker e.toRingHom).IsPrime := RingHom.ker_isPrime e
  exact formallySmooth_localization_of_jacobian 𝔓.asIdeal (Ideal.Quotient.mkₐ k 𝔓.asIdeal)
    Ideal.Quotient.mk_surjective (fun p ↦ Ideal.Quotient.eq_zero_iff_mem) y e heval f hf hli hloc

end Criterion

