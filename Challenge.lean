/-!
# Stafford's Conjecture 3.8

J. T. Stafford, *Module structure of Weyl algebras*, J. London Math. Soc. (2)
18 (1978), 429–442, states on page 438:

> Conjecture 3.8. Let `d ∈ Aₙ`. Then there exists `f ∈ Aₙ` such that
> `Aₙ = d Aₙ + f d Aₙ`.

Here `Aₙ = Aₙ(k)` is the `n`th Weyl algebra over a field `k` of characteristic
zero, generated by `x₁, …, xₙ, ∂₁, …, ∂ₙ` with `[∂ᵢ, xⱼ] = δᵢⱼ` and all other
pairs of generators commuting. Both `d Aₙ` and `f d Aₙ` are right ideals, and
`f` stands to the left of `d`. Membership of `1` in their sum is the identity
`1 = d R + f d S` for some `R, S ∈ Aₙ`, with the factors in this order.

The printed conjecture omits the hypothesis `d ≠ 0`, without which the
conclusion fails for `d = 0`; the discussion following it in the article uses
that hypothesis. This file states the intended nonzero form, for every
characteristic-zero field and every rank `n ≥ 0`. For `n = 0` the Weyl algebra
is the field itself and a nonzero `d` is a unit.

Besides this statement, the file states the results the accompanying paper
claims: Theorem 1.1 and Corollary 6.3 as printed, the stable cyclicity of
Corollary 6.3, and the consequences listed in Section 7 that have no printed
proof (the left-handed identity, Corollary 6.3 for left modules, the identity
for differential operators on localizations of `k[x_1, …, x_n]`, and the
identity with `F = x^r` for `d = p^r − ∑_j a_j x^{m_j}`).

The presentation and statements below repeat the exact definitions used by
`Stafford38.ChallengeDefinitions` and `Stafford38.PaperClaimDefinitions` in the
solution. Palomar requires the selected Challenge to import only authenticated
libraries. The independent Comparator checks that the definitions and theorem
types match; this file contains the deliberate placeholders filled by the
solution.
-/

namespace Stafford

variable {k A ι : Type*} [Field k] [Ring A] [Algebra k A]
  [Fintype ι] [DecidableEq ι]

/-- Linear combination of an indexed family by the rows of a matrix. -/
def linearCombination (M : Matrix ι ι k) (z : ι → A) (i : ι) : A :=
  ∑ j, algebraMap k A (M i j) * z j

variable {k ι : Type*} [Field k]

/-- The commutator relations presenting a Weyl-type algebra. -/
def freeWeylRelation (omega : Matrix ι ι k)
    (a b : FreeAlgebra k ι) : Prop :=
  ∃ i j,
    a = FreeAlgebra.ι k i * FreeAlgebra.ι k j -
      FreeAlgebra.ι k j * FreeAlgebra.ι k i ∧
    b = algebraMap k (FreeAlgebra k ι) (omega i j)

/-- The free algebra modulo the commutator relations encoded by `omega`. -/
abbrev FreeWeyl (k : Type*) [Field k] (ι : Type*)
    (omega : Matrix ι ι k) := RingQuot (freeWeylRelation omega)

/-- The canonical generators of the presented Weyl-type algebra. -/
def freeWeylGenerator (omega : Matrix ι ι k) (i : ι) : FreeWeyl k ι omega :=
  RingQuot.mkAlgHom k (freeWeylRelation omega) (FreeAlgebra.ι k i)

end Stafford

namespace Stafford
namespace Reduction

variable {k A : Type*} [Field k] [Ring A] [Algebra k A]

/-- Stafford 3.8 for one element, in written operator order. -/
def Stafford38 (e : A) : Prop := ∃ F R S : A, (1 : A) = e * R + F * e * S

end Reduction
end Stafford

namespace Stafford38Challenge

universe u

/-- Index type of the coordinate and momentum generators. -/
abbrev PhaseVar (n : ℕ) := Fin n ⊕ Fin n

/-- The Weyl commutator relation for the standard symplectic matrix. -/
abbrev relation {k : Type*} [Field k] {n : ℕ}
    (omega : Matrix (PhaseVar n) (PhaseVar n) k)
    (a b : FreeAlgebra k (PhaseVar n)) : Prop :=
  Stafford.freeWeylRelation omega a b

/-- The standard presented Weyl algebra, shared with the substantive proof. -/
abbrev WeylAlg (k : Type*) [Field k] (n : ℕ) :=
  Stafford.FreeWeyl k (PhaseVar n) (Matrix.J (Fin n) k)

/-- Stafford's Conjecture 3.8 in its intended nonzero form. -/
def UniversalStatement : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k] (n : ℕ) (d : WeylAlg k n),
    d ≠ 0 → Stafford.Reduction.Stafford38 d

/-- A named generator in the canonical presentation. -/
abbrev generator (k : Type*) [Field k] (n : ℕ) (i : PhaseVar n) : WeylAlg k n :=
  Stafford.freeWeylGenerator (Matrix.J (Fin n) k) i

/-- The standard symplectic form used for the fixed-source coordinate. -/
abbrev standardForm (k : Type*) [Field k] (n : ℕ) :
    Matrix (PhaseVar n) (PhaseVar n) k := Matrix.J (Fin n) k

end Stafford38Challenge

namespace Stafford38FixedSourceChallenge

universe u

/-- The fixed-source challenge uses the same phase variables and Weyl
presentation as the ordinary challenge. -/
abbrev PhaseVar (n : ℕ) := Stafford38Challenge.PhaseVar n

abbrev relation {k : Type u} [Field k] {n : ℕ}
    (omega : Matrix (PhaseVar n) (PhaseVar n) k)
    (a b : FreeAlgebra k (PhaseVar n)) : Prop :=
  Stafford38Challenge.relation omega a b

abbrev WeylAlg (k : Type u) [Field k] (n : ℕ) :=
  Stafford38Challenge.WeylAlg k n

abbrev generator (k : Type u) [Field k] (n : ℕ) (i : PhaseVar n) : WeylAlg k n :=
  Stafford38Challenge.generator k n i

/-- Insert an old phase variable after the newest coordinate or momentum. -/
def oldIndex {n : ℕ} : PhaseVar n → PhaseVar (n + 1)
  | .inl i => .inl i.succ
  | .inr i => .inr i.succ

@[simp] theorem oldIndex_inl {n : ℕ} (i : Fin n) :
    oldIndex (.inl i) = .inl i.succ := rfl

@[simp] theorem oldIndex_inr {n : ℕ} (i : Fin n) :
    oldIndex (.inr i) = .inr i.succ := rfl

/-- Insert an old free-algebra word into the next-rank free algebra. -/
def freeOldMap (k : Type u) [Field k] (n : ℕ) :
    FreeAlgebra k (PhaseVar n) →ₐ[k] FreeAlgebra k (PhaseVar (n + 1)) :=
  FreeAlgebra.lift k (fun i => FreeAlgebra.ι k (oldIndex i))

/-- Ordered PBW words, with old pairs followed by the newest pair. -/
def freeOrderedMonomial (k : Type u) [Field k] :
    (n : ℕ) → (Fin n → ℕ) → (Fin n → ℕ) → FreeAlgebra k (PhaseVar n)
  | 0, _, _ => 1
  | n + 1, a, p =>
      freeOldMap k n
          (freeOrderedMonomial k n (fun i => a i.succ) (fun i => p i.succ)) *
        FreeAlgebra.ι k (.inl (0 : Fin (n + 1))) ^ a 0 *
        FreeAlgebra.ι k (.inr (0 : Fin (n + 1))) ^ p 0

/-- The image of an ordered PBW word in the shared Weyl quotient. -/
def orderedMonomial (k : Type u) [Field k] (n : ℕ)
    (a p : Fin n → ℕ) : WeylAlg k n :=
  RingQuot.mkAlgHom k (relation (k := k) (n := n) (Matrix.J (Fin n) k))
    (freeOrderedMonomial k n a p)

/-- Total degree of a split coordinate/momentum exponent. -/
def phaseDegree {n : ℕ} (a p : Fin n → ℕ) : ℕ :=
  (∑ i, a i) + ∑ i, p i

/-- Span of the ordered Weyl words of total degree at most `N`. -/
def bernsteinPiece (k : Type u) [Field k] (n N : ℕ) :
    Submodule k (WeylAlg k n) :=
  Submodule.span k
    {z | ∃ a p : Fin n → ℕ,
      phaseDegree a p ≤ N ∧ z = orderedMonomial k n a p}

/-- The intrinsic Bernstein degree of a presented element: its least piece. -/
noncomputable def bernsteinDegree (k : Type u) [Field k] {n : ℕ}
    (d : WeylAlg k n) : ℕ :=
  sInf {N : ℕ | d ∈ bernsteinPiece k n N}

/-- The shared matrix-row combination used to name a linear source. -/
abbrev linearCombination (k : Type u) [Field k] {n : ℕ}
    (M : Matrix (PhaseVar n) (PhaseVar n) k)
    (z : PhaseVar n → WeylAlg k n) (i : PhaseVar n) : WeylAlg k n :=
  Stafford.linearCombination M z i

abbrev standardForm (k : Type u) [Field k] (n : ℕ) :
    Matrix (PhaseVar n) (PhaseVar n) k := Stafford38Challenge.standardForm k n

/-- A source coordinate obtained from an invertible symplectic linear change
of the canonical Weyl generators. -/
def IsLinearWeylCoordinate (k : Type u) [Field k] (n : ℕ)
    (ell : WeylAlg k (n + 1)) : Prop :=
  ∃ (M N : Matrix (PhaseVar (n + 1)) (PhaseVar (n + 1)) k)
      (_hM : M * standardForm k (n + 1) * Matrix.transpose M =
        standardForm k (n + 1))
      (_hN : N * standardForm k (n + 1) * Matrix.transpose N =
        standardForm k (n + 1))
      (_hMN : M * N = 1) (_hNM : N * M = 1),
      ell = linearCombination k N (generator k (n + 1))
        (.inl (0 : Fin (n + 1)))

/-- Shared template for the fixed-source proposition, parameterized only by
the chosen degree function. -/
def UniversalFixedSourceStatementWithDegree
    (degree : ∀ (k : Type u) [Field k] {n : ℕ}, WeylAlg k n → ℕ) : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k] (n : ℕ)
    (d : WeylAlg k (n + 1)), d ≠ 0 →
      ∃ ell R S : WeylAlg k (n + 1),
        IsLinearWeylCoordinate k n ell ∧
          (1 : WeylAlg k (n + 1)) =
            d * R + ell ^ degree k d * d * S

/-- The exact fixed-source challenge, using the intrinsic degree. -/
abbrev UniversalFixedSourceStatement : Prop :=
  UniversalFixedSourceStatementWithDegree.{u} bernsteinDegree

end Stafford38FixedSourceChallenge

namespace Stafford38.TorsionCyclicity

universe u v

/-- Every element of a right module is killed by some nonzero right scalar. -/
def IsRightTorsion {A : Type u} {M : Type v} [Ring A]
    [AddCommGroup M] [Module Aᵐᵒᵖ M] : Prop :=
  ∀ m : M, ∃ d : A, d ≠ 0 ∧ (MulOpposite.op d : Aᵐᵒᵖ) • m = 0

end Stafford38.TorsionCyclicity

namespace Stafford38Challenge

universe u v

/-- The generator `x₁` of `A_n(k)`, `n ≥ 1`. -/
abbrev x₁ (k : Type*) [Field k] {n : ℕ} (hn : 0 < n) : WeylAlg k n :=
  generator k n (.inl ⟨0, hn⟩)

/-- The linear map `g` on the generator space `V = span(x_1, …, ∂_n)`, given by
the rows of its matrix: `g(u_i) = ∑_j g_ij u_j`. -/
abbrev linearImage (k : Type*) [Field k] {n : ℕ}
    (g : Matrix (PhaseVar n) (PhaseVar n) k) (i : PhaseVar n) : WeylAlg k n :=
  Stafford.linearCombination g (generator k n) i

/-- An `ω`-preserving `g` (`g J gᵀ = J`) preserves the Weyl relations
`[u_i, u_j] = J_ij`. -/
theorem linearImage_rel (k : Type*) [Field k] {n : ℕ}
    (g : Matrix.symplecticGroup (Fin n) k) ⦃a b : FreeAlgebra k (PhaseVar n)⦄
    (h : relation (Matrix.J (Fin n) k) a b) :
    FreeAlgebra.lift k (linearImage k (g : Matrix (PhaseVar n) (PhaseVar n) k)) a =
      FreeAlgebra.lift k (linearImage k (g : Matrix (PhaseVar n) (PhaseVar n) k)) b := by
  obtain ⟨i, j, rfl, rfl⟩ := h
  have hcomm : ∀ p q : PhaseVar n,
      generator k n p * generator k n q - generator k n q * generator k n p =
        algebraMap k (WeylAlg k n) (Matrix.J (Fin n) k p q) := by
    intro p q
    have := RingQuot.mkAlgHom_rel k
      (show relation (Matrix.J (Fin n) k) _ _ from ⟨p, q, rfl, rfl⟩)
    simpa [generator, Stafford.freeWeylGenerator, map_sub, map_mul] using this
  have hg := (SymplecticGroup.mem_iff).mp g.2
  -- Reversed simp lemmas (`← l`) would become helpers named after the compiling
  -- module, so challenge and solution copies of this proof would differ.
  have smul_def' : ∀ (c : k) (x : WeylAlg k n), algebraMap k (WeylAlg k n) c * x = c • x :=
    fun c x => (Algebra.smul_def c x).symm
  have sum_sub' : ∀ (s : Finset (PhaseVar n)) (f f' : PhaseVar n → WeylAlg k n),
      ∑ p ∈ s, f p - ∑ p ∈ s, f' p = ∑ p ∈ s, (f p - f' p) :=
    fun s f f' => (Finset.sum_sub_distrib f f').symm
  have sum_algebraMap : ∀ (s : Finset (PhaseVar n)) (f : PhaseVar n → k),
      ∑ p ∈ s, algebraMap k (WeylAlg k n) (f p) = algebraMap k (WeylAlg k n) (∑ p ∈ s, f p) :=
    fun s f => (map_sum (algebraMap k (WeylAlg k n)) f s).symm
  simp only [map_sub, map_mul, FreeAlgebra.lift_ι_apply, AlgHom.commutes, linearImage,
    Stafford.linearCombination, smul_def', Finset.sum_mul, Finset.mul_sum,
    smul_mul_smul_comm]
  rw [Finset.sum_comm, ← Finset.sum_sub_distrib]
  simp_rw [sum_sub']
  have hterm : ∀ p q : PhaseVar n,
      ((g : Matrix _ _ k) i p * (g : Matrix _ _ k) j q) • (generator k n p * generator k n q) -
        ((g : Matrix _ _ k) j q * (g : Matrix _ _ k) i p) • (generator k n q * generator k n p) =
      algebraMap k (WeylAlg k n)
        ((g : Matrix _ _ k) i p * Matrix.J (Fin n) k p q * (g : Matrix _ _ k) j q) := by
    intro p q
    rw [mul_comm ((g : Matrix _ _ k) j q)]
    rw [show ∀ (c : k) (x y : WeylAlg k n), c • x - c • y = c • (x - y) from
      fun c x y => (smul_sub c x y).symm, hcomm, Algebra.smul_def, ← map_mul]
    congr 1
    ring
  simp_rw [hterm, sum_algebraMap]
  congr 1
  conv_rhs => rw [← hg]
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
  rw [Finset.sum_comm]

/-- **`Φ_g`**: for a linear `ω`-preserving automorphism `g` of the generator
space (`g J gᵀ = J`, i.e. `g ∈ Sp(2n, k)`), the algebra automorphism of
`A_n(k)` extending `u_i ↦ g(u_i) = ∑_j g_ij u_j`.  Its inverse is
`Φ_g⁻¹ = Φ_{g⁻¹}`. -/
noncomputable def phiG (k : Type*) [Field k] (n : ℕ) (g : Matrix.symplecticGroup (Fin n) k) :
    WeylAlg k n →ₐ[k] WeylAlg k n :=
  RingQuot.liftAlgHom k
    ⟨FreeAlgebra.lift k (linearImage k (g : Matrix (PhaseVar n) (PhaseVar n) k)),
      fun _ _ h => linearImage_rel k g h⟩

/-- A right module `M` is cyclic: `M = mA` for some `m ∈ M`. -/
def IsCyclicModule (A : Type u) (M : Type v) [Ring A] [AddCommGroup M] [Module Aᵐᵒᵖ M] :
    Prop :=
  ∃ m : M, ∀ x : M, ∃ a : A, x = MulOpposite.op a • m

/-- **Theorem 1.1.**  For every field of characteristic zero `k`, every `n ≥ 0`
and every nonzero `d ∈ A_n(k)`, there exists an `F ∈ A_n(k)` such that
`A_n(k) = dA_n(k) + FdA_n(k)`, or equivalently, there exist `F, S, R ∈ A_n(k)`
such that `1 = dR + FdS`.  Moreover, if `n ≥ 1`, one may choose
`F = Φ_g^{-1}(x₁)^{deg_B d}` for a linear `ω`-preserving automorphism `g`. -/
def PaperTheorem_1_1 : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k] (n : ℕ) (d : WeylAlg k n), d ≠ 0 →
    (∃ F : WeylAlg k n, (⊤ : Submodule (WeylAlg k n)ᵐᵒᵖ (WeylAlg k n)) =
        Submodule.span (WeylAlg k n)ᵐᵒᵖ {d} ⊔ Submodule.span (WeylAlg k n)ᵐᵒᵖ {F * d}) ∧
      (∃ F S R : WeylAlg k n, (1 : WeylAlg k n) = d * R + F * d * S) ∧
      (∀ hn : 1 ≤ n, ∃ g : Matrix.symplecticGroup (Fin n) k, ∃ R S : WeylAlg k n,
        (1 : WeylAlg k n) = d * R +
          phiG k n g⁻¹ (x₁ k hn) ^ Stafford38FixedSourceChallenge.bernsteinDegree k d * d * S)

/-- **Corollary 6.3** (Stafford 1978).  Every finitely generated torsion right
`A_n(k)`-module is cyclic. -/
def PaperCorollary_6_3 : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k] (n : ℕ) (M : Type v) [AddCommGroup M]
    [Module (WeylAlg k n)ᵐᵒᵖ M] [Module.Finite (WeylAlg k n)ᵐᵒᵖ M],
    Stafford38.TorsionCyclicity.IsRightTorsion (A := WeylAlg k n) (M := M) →
      IsCyclicModule (WeylAlg k n) M

end Stafford38Challenge

namespace Stafford38Challenge

universe u v

/-- Stafford's *stably cyclic* [Sta78, p. 435], as quoted in the proof of
Corollary 6.3 (tex line 1619): "given `l ≥ 1` and `a_1, …, a_{l+1} ∈ T` that
generate `T`, there exist `f_i ∈ A_n` such that `a_i + a_{l+1} f_i`,
`i = 1, …, l`, also generate `T`". -/
def IsStablyCyclic (A : Type u) (T : Type v) [Ring A] [AddCommGroup T] [Module Aᵐᵒᵖ T] :
    Prop :=
  ∀ l ≥ 1, ∀ a : Fin (l + 1) → T, Submodule.span Aᵐᵒᵖ (Set.range a) = ⊤ →
    ∃ f : Fin l → A, Submodule.span Aᵐᵒᵖ
      (Set.range fun i : Fin l => a i.castSucc + (MulOpposite.op (f i) : Aᵐᵒᵖ) • a (Fin.last l)) =
        ⊤

/-- **Corollary 6.3, stable cyclicity** (tex lines 75, 108, 1619).  Every
finitely generated torsion right `A_n(k)`-module is stably cyclic. -/
def PaperCorollary_6_3_stablyCyclic : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k] (n : ℕ) (M : Type v) [AddCommGroup M]
    [Module (WeylAlg k n)ᵐᵒᵖ M] [Module.Finite (WeylAlg k n)ᵐᵒᵖ M],
    Stafford38.TorsionCyclicity.IsRightTorsion (A := WeylAlg k n) (M := M) →
      IsStablyCyclic (WeylAlg k n) M

/-- **Section 7, left-handed identity** (tex lines 1629–1630): every nonzero
`d ∈ A_n(k)` has `R, S, F` with `1 = Rd + SdF`. -/
def LeftHandedIdentity : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k] (n : ℕ) (d : WeylAlg k n), d ≠ 0 →
    ∃ R S F : WeylAlg k n, (1 : WeylAlg k n) = R * d + S * d * F

/-- Every element of a left module is killed by some nonzero scalar. -/
def IsLeftTorsion (A : Type u) (M : Type v) [Ring A] [AddCommGroup M] [Module A M] : Prop :=
  ∀ m : M, ∃ d : A, d ≠ 0 ∧ d • m = 0

/-- A left module `M` is cyclic: `M = Am` for some `m ∈ M`. -/
def IsLeftCyclicModule (A : Type u) (M : Type v) [Ring A] [AddCommGroup M] [Module A M] :
    Prop :=
  ∃ m : M, ∀ x : M, ∃ a : A, x = a • m

/-- **Section 7, Corollary 6.3 for left torsion modules** (tex line 1630):
every finitely generated torsion left `A_n(k)`-module is cyclic. -/
def LeftCorollary_6_3 : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k] (n : ℕ) (M : Type v) [AddCommGroup M]
    [Module (WeylAlg k n) M] [Module.Finite (WeylAlg k n) M],
    IsLeftTorsion (WeylAlg k n) M → IsLeftCyclicModule (WeylAlg k n) M

/-- `P` is a `k`-linear differential operator of order at most `N` on the
commutative `k`-algebra `B` (Grothendieck): every iterated commutator
`[…[[P, b₀], b₁], …, b_N]` with multiplication operators vanishes, where
`[Q, b] = Q ∘ b − b ∘ Q`. -/
def IsDifferentialOperatorOfOrder (k : Type u) (B : Type v) [CommRing k] [CommRing B]
    [Algebra k B] (N : ℕ) (P : Module.End k B) : Prop :=
  ∀ b : List B, b.length = N + 1 →
    b.foldl (fun Q c => Q * LinearMap.mulLeft k c - LinearMap.mulLeft k c * Q) P = 0

/-- `P` is a `k`-linear differential operator of finite order on `B`. -/
def IsDifferentialOperator (k : Type u) (B : Type v) [CommRing k] [CommRing B]
    [Algebra k B] (P : Module.End k B) : Prop :=
  ∃ N, IsDifferentialOperatorOfOrder k B N P

/-- The identity `1 = dR + FdS` in the ring `D_k(B)` of finite-order
`k`-linear differential operators on `B`: for every nonzero `d ∈ D_k(B)` there
are `F, R, S ∈ D_k(B)` with `1 = dR + FdS`. -/
def HasDifferentialIdentity (k : Type u) (B : Type v) [CommRing k] [CommRing B]
    [Algebra k B] : Prop :=
  ∀ d : Module.End k B, IsDifferentialOperator k B d → d ≠ 0 →
    ∃ F R S : Module.End k B, IsDifferentialOperator k B F ∧ IsDifferentialOperator k B R ∧
      IsDifferentialOperator k B S ∧ (1 : Module.End k B) = d * R + F * d * S

/-- **Section 7, localizations** (tex lines 1630–1631): the identity for
finite-order differential operators on every localization `B = S⁻¹k[x_1, …, x_n]`. -/
def LocalizedDifferentialIdentity : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k] (n : ℕ) (S : Submonoid (MvPolynomial (Fin n) k))
    (B : Type v) [CommRing B] [Algebra (MvPolynomial (Fin n) k) B] [Algebra k B]
    [IsScalarTower k (MvPolynomial (Fin n) k) B] [IsLocalization S B],
    HasDifferentialIdentity k B

/-- **Section 7, evolutionary identity** (tex lines 1631–1634): for `r ≥ 1`, in
every `k`-algebra `D` with `px = xp + 1`, the element
`d = p^r − ∑_j a_j x^{m_j}`, each `a_j` commuting with `x` and `p`, has
`R, S` with `1 = dR + x^r d S`. -/
def EvolutionaryIdentity : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k] (D : Type v) [Ring D] [Algebra k D] (x p : D),
    p * x = x * p + 1 → ∀ r : ℕ, 1 ≤ r → ∀ (J : ℕ) (a : Fin J → D) (m : Fin J → ℕ),
      (∀ j, a j * x = x * a j) → (∀ j, a j * p = p * a j) →
        ∃ R S : D, (1 : D) = (p ^ r - ∑ j, a j * x ^ m j) * R +
          x ^ r * (p ^ r - ∑ j, a j * x ^ m j) * S

end Stafford38Challenge

